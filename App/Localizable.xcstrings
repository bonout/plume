    "%lld of %lld files couldn't be sent yet. Plume will send them the next time it opens.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld fichiers sur %2$lld n’ont pas encore pu être envoyés. Plume les enverra à sa prochaine ouverture."
          }
        }
      }
    },
