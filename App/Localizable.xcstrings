      }
    },
    "The server is in maintenance mode. Try again in a few minutes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur est en maintenance. Réessayez dans quelques minutes."
          }
        }
      }
    },
    "The server no longer accepts Plume's app password. It may have been revoked in Nextcloud's security settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’accepte plus le mot de passe d’application de Plume. Il a peut-être été révoqué dans les paramètres de sécurité de Nextcloud."
          }
        }
      }
    },
    "The server refused the credentials. Sign in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé les identifiants. Reconnectez-vous."
          }
        }
      }
    },
    "The server requires a password on links.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur exige un mot de passe sur les liens."
          }
        }
      }
    },
    "The server's security certificate isn't trusted. Plume only connects to servers with a certificate from a recognized authority, such as Let's Encrypt.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de sécurité du serveur n’est pas reconnu. Plume se connecte uniquement aux serveurs dotés d’un certificat d’une autorité reconnue, comme Let’s Encrypt."
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
        }
      }
    },
    "This item no longer exists on the server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
