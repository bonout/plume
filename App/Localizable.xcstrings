    "Nextcloud": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nextcloud"
          }
        }
      }
    },
    "Nextcloud is free, open-source software for keeping your files on a server you choose: one you run at home, or one from a hosting provider. Your files stay on that server, not with a big tech company.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nextcloud est un logiciel libre et gratuit pour garder vos fichiers sur le serveur de votre choix : chez vous, ou chez un hébergeur. Vos fichiers restent sur ce serveur, pas chez un géant de la tech."
          }
        }
      }
    },
    "No Favorites": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun favori"
          }
        }
      }
    },
    "No Folders": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier"
          }
        }
      }
    },
    "No Nextcloud server answered at this address. Enter the address you use to open Nextcloud in a browser, for example cloud.example.com.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur Nextcloud n’a répondu à cette adresse. Saisissez l’adresse que vous utilisez pour ouvrir Nextcloud dans un navigateur, par exemple cloud.example.com."
          }
        }
      }
    },
    "No WebDAV folder answered at this address. Enter the full address of the WebDAV folder, for example https://nas.example.com/webdav.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier WebDAV n’a répondu à cette adresse. Saisissez l’adresse complète du dossier WebDAV, par exemple https://nas.example.com/webdav."
          }
        }
      }
    },
    "No earlier versions.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune version précédente."
          }
        }
      }
    },
    "Not enough storage left on the server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace de stockage insuffisant sur le serveur."
