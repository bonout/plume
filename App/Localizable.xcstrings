    "Plume": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plume"
          }
        }
      }
    },
    "Plume is an app for your Nextcloud: it shows the files of your account, finds them as you type, keeps the ones you choose on this device, and puts them in Files and Finder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plume est une app pour votre Nextcloud : elle affiche les fichiers de votre compte, les retrouve dès la frappe, garde ceux que vous choisissez sur cet appareil et les intègre à Fichiers et au Finder."
          }
        }
      }
    },
    "Plume is an independent app, not affiliated with Nextcloud GmbH.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plume est une app indépendante, non affiliée à Nextcloud GmbH."
          }
        }
      }
    },
