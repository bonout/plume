    "This server doesn't support this action.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur ne prend pas en charge cette action."
          }
        }
      }
    },
    "To use Plume you need a Nextcloud account. Enter the address you use to open Nextcloud in a browser, then sign in there: Plume receives its own app password, which you can revoke at any time.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser Plume, il vous faut un compte Nextcloud. Saisissez l’adresse que vous utilisez pour ouvrir Nextcloud dans un navigateur, puis connectez-vous : Plume reçoit son propre mot de passe d’application, révocable à tout moment."
          }
        }
      }
    },
